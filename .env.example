# E-Mail-Versand des Kontaktformulars über Resend. Anleitung: docs/resend.md
# Kopieren nach .env.local und ausfüllen. Keine echten Werte in diese Datei schreiben.

# API-Schlüssel aus dem Resend-Dashboard (beginnt mit "re_").
# Leer lassen in der Entwicklung: Die E-Mails werden dann nur in der Konsole ausgegeben.
RESEND_API_KEY=

# Empfänger der Benachrichtigung über neue Anfragen, z. B. kontakt@name-qm.de.
# Ohne verifizierte Domain muss das die E-Mail-Adresse des Resend-Kontos sein.
CONTACT_TO_EMAIL=

# Absender, z. B. "NAME.QM <kontakt@name-qm.de>" (Domain muss bei Resend verifiziert sein).
# Leer lassen zum Testen: Dann wird "NAME.QM <onboarding@resend.dev>" verwendet.
CONTACT_FROM_EMAIL=
